node_modules
.DS_STORE

dist/
.chrome-profile/

# ── The rendered protected pages ─────────────────────────────────────────────
# Build artifact written by scripts/prepare-private.mjs and bundled into the
# Worker by `main`. It holds the GATED pages' complete HTML, so committing it
# puts content that is behind a password into git history, into every clone and
# into every fork — where deleting it later does not help.
#
# The SOURCE is committed and should be: private/html/ and private/pages.json
# are what make the build reproducible. Only the rendered output is excluded.
#
# `scripts/lib/gate.mjs` writes an empty `{}` here when it is missing, so a
# clean checkout can import the Worker (and therefore run the tests) before
# anything has been built. An empty manifest 404s every protected route, which
# is the correct failure direction.
worker/*.generated.json

# ── Secrets ──────────────────────────────────────────────────────────────────
# No leading slash, so these match at ANY depth — studio/.env is covered by
# the same rules as the root one.
#
# `.env` alone is NOT enough: git matches it as an exact filename, and
# migration-scripts/guard-production-deploy.mjs explicitly scans .env.local,
# .env.production and .env.production.local as well. Anything the guard reads
# is a file that can exist, and therefore a file that can be committed.
.env
.env.*
.dev.vars
.dev.vars.*

# ...but the committed templates must survive the rules above.
!.env.example
!.dev.vars.example

# Sanity Studio build output (dist/ above only matches the directory name,
# which does cover studio/dist and web/dist — listed for clarity).
.sanity/

# The raw Webflow dump. `migration-scripts/webflow/pull.mjs` documents this as
# gitignored and it was NOT — which would have committed 216 review items,
# including named individuals' review text and their Google avatar URLs, into
# git history permanently. It is large, re-pullable with one command, and the
# auditable artifact is the CONVERTED output, not the input.
migration/raw/

# Astro
.astro/

# Wrangler's local state — miniflare's emulated KV/R2/D1/cache sqlite files
# and the generated deploy config. Created by `astro build` (the Cloudflare
# adapter) and by any wrangler invocation, including `--dry-run`.
.wrangler/
