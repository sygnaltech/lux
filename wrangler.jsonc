// ─────────────────────────────────────────────────────────────────────────────
// LOCAL PREVIEW config. Not used for deploying.
//
// `npm run deploy` and `npm run check:deploy` both pass
// `--config wrangler.prod.jsonc` explicitly. A dry run against THIS file
// proves nothing about the production one, which is the file that can take the
// client's hostname — so never validate the deploy with this config.
//
// Differences from production are deliberate and limited to: no account_id
// (not needed locally), and no routes block at all.
// ─────────────────────────────────────────────────────────────────────────────
{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "site-luxradiology-local",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat"],

	// NO "main". `output: 'static'` with no on-demand route emits an empty
	// dist/server — there is no Worker. This is an assets-only deployment.
	// If §6 ever adds `prerender = false` to a route, a Worker entrypoint
	// appears and must be wired up here AND in the production config, and
	// `not_found_handling` must come out of both. See §8.

	"assets": {
		// Flat by configuration, not by default: astro.config.mjs sets
		// `build.client: './'` so pages land directly here rather than in
		// dist/client, which is what the migration engine's verifiers assume.
		// Astro's server output is pushed to dist/_server and ignored via
		// web/public/.assetsignore.
		"directory": "./web/dist",

		// Correct ONLY because every route prerenders. The asset layer answers
		// "404-page" BEFORE any Worker runs, so with an on-demand route this
		// would intercept exactly the paths the Worker exists to render. The
		// skill reports a site that shipped the opposite mistake and served a
		// 404 page that could never appear.
		"not_found_handling": "404-page"
	}
}
