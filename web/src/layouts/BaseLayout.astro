---
/**
 * The shell for every ported Webflow page.
 *
 * Takes a slug, looks it up in the extractor's manifest, and re-emits the page:
 * Webflow's own <head> furniture, then the verbatim body fragment with the
 * `<!--wf:nav-->` / `<!--wf:footer-->` markers substituted for the shared nav
 * and footer.
 *
 * FRAGMENTS ARE LOADED WITH import.meta.glob + ?raw, NOT readFile.
 *
 * Vite inlines them into the bundle at build time, so this works regardless of
 * what runtime prerenders the page. A `readFile` here would fail under the
 * Cloudflare adapter's workerd prerenderer, whose cwd is `/bundle` with no
 * repository filesystem — the same wall that broke the project.jsonc read.
 * `eager: true` because every page needs its fragment synchronously during
 * render.
 *
 * NOTHING IN THE BODY IS RECONSTRUCTED. The fragments are the live site's
 * bytes with only asset URLs rewritten. Resist improving the markup here: the
 * CSS is Webflow's, selector- and generated-id-driven, and a hand-written
 * equivalent is a redesign with a migration's budget.
 */
import manifest from '../data/pages.json';

interface Props {
  /**
   * Manifest key. For a static page that is its own route ('home', 'about',
   * 'book/sat'). For a CMS item page it is the TEMPLATE's key ('tpl-reviews'),
   * which supplies the furniture — the body markup, the shell markers and the
   * Webflow page id — while the props below supply what is per-document.
   */
  slug: string;

  /**
   * Body HTML to use instead of the template's raw fragment.
   *
   * A CMS route binds the document into the template (see src/lib/bind.ts) and
   * passes the result here. The shell markers are substituted afterwards, so a
   * route never has to think about the nav and footer.
   */
  body?: string;

  /** Per-document <title>. Falls back to the manifest's. */
  title?: string;
  /** Per-document meta description. Falls back to the manifest's. */
  description?: string;

  /**
   * The item's own path, e.g. '/reviews/lubna'.
   *
   * REQUIRED FOR A CMS ITEM PAGE. The extracted `head-extra.tpl-*.html`
   * carries the SAMPLE item's `<link rel="canonical">`, so without this every
   * page in the collection would declare the sample's URL as canonical and
   * invite Google to drop 168 of 169 review pages.
   */
  canonicalPath?: string;
}

const {
  slug,
  body: bodyOverride,
  title: titleOverride,
  description: descriptionOverride,
  canonicalPath,
} = Astro.props;

const page = (manifest.pages as Record<string, PageEntry>)[slug];
if (!page) {
  throw new Error(
    `BaseLayout: no manifest entry for slug "${slug}". ` +
      `Known slugs: ${Object.keys(manifest.pages).join(', ')}`,
  );
}

interface PageEntry {
  path: string;
  template: boolean;
  wfPage?: string;
  lang?: string;
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  shell: 'full' | 'nav' | 'bare';
  headExtra?: boolean;
}

/**
 * Every extracted fragment, keyed by its path within src/html.
 *
 * A slug containing `/` is stored with `__` in the filename — `book/sat`
 * becomes `main.book__sat.html` — because a slash in a filename would be a
 * directory. The extractor does the same mapping on the way out.
 */
const fragments = import.meta.glob<string>('../html/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const fileFor = (s: string) => s.replace(/\//g, '__');
const frag = (name: string): string => fragments[`../html/${name}`] ?? '';

const main = bodyOverride ?? frag(`main.${fileFor(slug)}.html`);
const nav = frag('nav.html');
const footer = frag('footer.html');

const rawHeadExtra = page.headExtra ? frag(`head-extra.${fileFor(slug)}.html`) : '';

/**
 * Point the canonical link at THIS document, not the template's sample item.
 *
 * `head-extra.tpl-reviews.html` is one line: the canonical URL of the single
 * review the template was extracted from. Re-emitted unchanged on all 169
 * review pages it tells Google that 168 of them are duplicates of the 169th,
 * which is a quiet way to lose a collection from the index. Replacing rather
 * than appending, because two canonical links are ignored outright.
 */
const headExtra = canonicalPath
  ? rawHeadExtra.replace(
      /<link[^>]*rel="canonical"[^>]*>/,
      `<link href="${manifest.extractedFrom}${canonicalPath}" rel="canonical"/>`,
    )
  : rawHeadExtra;

/**
 * Drop Webflow's `preconnect` to its own CDN.
 *
 * §5 localised every asset, so nothing on this site loads from
 * `cdn.prod.website-files.com` any more — the hint now opens a TCP+TLS
 * connection to the host we are leaving, on every page load, for nothing. It
 * is also the last thing making `npm run assets:check` report Webflow as a
 * referenced host, which would mask a real regression later.
 *
 * Done HERE rather than by editing src/html/head-custom.html, because that
 * file is regenerated by `npm run extract` and the hand-edit would silently
 * come back.
 */
const headCustom = frag('head-custom.html').replace(
  /\s*<link[^>]*href="https:\/\/cdn\.prod\.website-files\.com"[^>]*>/g,
  '',
);

if (!main) throw new Error(`BaseLayout: no main fragment for slug "${slug}".`);

/**
 * Substitute the shell markers.
 *
 * THESE MUST THROW WHEN THE SUBSTITUTION CANNOT HAPPEN, and that is the whole
 * design. A silent fallback leaves the comment marker in the output and the
 * page renders without a nav — which looks like a CSS problem, not a build
 * problem, and the structural verifier's tag count would be the only hint.
 *
 * A `bare` page legitimately has no markers (Webflow's /410 and /search render
 * no site chrome), so the check is per-shell rather than unconditional.
 */
function substitute(html: string): string {
  let out = html;

  if (page.shell === 'full' || page.shell === 'nav') {
    if (!out.includes('<!--wf:nav-->')) {
      throw new Error(`BaseLayout: "${slug}" is shell:${page.shell} but its fragment has no <!--wf:nav--> marker.`);
    }
    if (!nav) throw new Error(`BaseLayout: "${slug}" needs the shared nav, but nav.html is empty.`);
    out = out.replace('<!--wf:nav-->', nav);
  }

  if (page.shell === 'full') {
    if (!out.includes('<!--wf:footer-->')) {
      throw new Error(`BaseLayout: "${slug}" is shell:full but its fragment has no <!--wf:footer--> marker.`);
    }
    if (!footer) throw new Error(`BaseLayout: "${slug}" needs the shared footer, but footer.html is empty.`);
    out = out.replace('<!--wf:footer-->', footer);
  }

  return out;
}

const body = substitute(main);

/**
 * Webflow's site identifier, constant across every page of this site.
 *
 * It is on the live `<html>` element and is kept for fidelity: Webflow's
 * shipped runtime reads it, and the ported pages still load that runtime.
 * It is NOT in the extractor's manifest (which captures only `data-wf-page`
 * and `lang`), and it does not belong in project.jsonc either — that file is
 * for what the migration ENGINE needs, not for markup constants.
 */
const WF_SITE = '60f0b32c84789d2d1b5ddbb8';

/** data-wf-domain is the canonical host, which is the live host. */
const wfDomain = new URL(manifest.extractedFrom).hostname;

/**
 * Page metadata: per-document where a CMS route supplied it, the template's
 * otherwise. A CMS item page that fell back to the template's title would ship
 * the sample item's name in the browser tab and in every share card.
 */
const pageTitle = titleOverride ?? page.title;
const pageDescription = descriptionOverride ?? page.description;
const ogTitle = titleOverride ?? page.ogTitle;
const ogDescription = descriptionOverride ?? page.ogDescription;
---

<html
  data-wf-domain={wfDomain}
  data-wf-page={page.wfPage}
  data-wf-site={WF_SITE}
  lang={page.lang ?? 'en'}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Interpolated, NOT set:html. The manifest stores DECODED text, so Astro
      escapes exactly once here. The extractor used to store the raw <title>
      — already HTML-escaped — and this escaped it again, so pages rendered a
      literal "&amp;" in the browser tab. Three Lux titles contain "&".
    */}
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    {ogTitle && <meta name="twitter:title" content={ogTitle} />}
    {ogDescription && <meta name="twitter:description" content={ogDescription} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <Fragment set:html={headCustom} />
    <Fragment set:html={headExtra} />
  </head>

  <body>
    <Fragment set:html={body} />
    <slot />
  </body>
</html>
