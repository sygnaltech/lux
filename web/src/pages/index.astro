---
/**
 * The home page.
 *
 * Its own route rather than part of [...slug].astro: `/` is not a catch-all
 * param, and home carries the most CMS lists on the site (11 against a
 * nav+footer baseline of 7) plus its own JSON-LD, so it is the page most
 * likely to need hand-written additions as §6 binds the collections.
 *
 * Right now it is the ported fragment and nothing else — which is correct
 * until there is a dataset to read.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout slug="home" />
