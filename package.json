{
  "name": "lux-radiology",
  "version": "0.1.1",
  "private": true,
  "description": "Lux Radiology — Webflow to Astro + Sanity migration. This root package is an ORCHESTRATOR: it owns the migration engine, both Wrangler configs and the deploy guards, and delegates app commands to web/ and studio/.",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev --",
    "build": "npm --prefix web run build --",
    "check": "npm --prefix web run check --",
    "prebuild": "npm run redirects",
    "studio:dev": "npm --prefix studio run dev --",
    "studio:build": "npm --prefix studio run build --",
    "studio:deploy": "node migration-scripts/guard-production-deploy.mjs --studio && npm --prefix studio run deploy --",
    "guard:deploy": "node migration-scripts/guard-production-deploy.mjs",
    "deploy": "npm run guard:deploy && npm run build && wrangler deploy --config wrangler.prod.jsonc",
    "check:deploy": "wrangler deploy --dry-run --config wrangler.prod.jsonc",
    "extract": "node migration-scripts/extract-webflow-page.mjs",
    "fetch:assets": "node migration-scripts/fetch-webflow-assets.mjs",
    "localise:assets": "node migration-scripts/localise-webflow-assets.mjs",
    "assets:check": "node migration-scripts/check-assets.mjs",
    "verify": "node migration-scripts/verify-port.mjs",
    "sitemap": "node migration-scripts/check-sitemap.mjs",
    "redirects": "node migration-scripts/gen-redirects.mjs",
    "seams": "node migration-scripts/cms-seams.mjs",
    "wf:pull": "node migration-scripts/webflow/pull.mjs",
    "wf:from-dump": "node migration-scripts/webflow/from-mcp-dump.mjs",
    "sanity:convert": "node migration-scripts/sanity/convert.mjs --report",
    "sanity:import": "node migration-scripts/sanity/import.mjs",
    "sanity:verify": "node migration-scripts/sanity/verify.mjs",
    "test": "node migration-scripts/sanity/test-converter.mjs && node migration-scripts/sanity/test-portable.mjs",
    "preflight": "npm run build && npm test && npm run check && npm run verify && npm run sitemap && npm run assets:check && npm run cms:images && npm run sanity:verify",
    "engine:build": "npm --prefix engine run build --",
    "engine:watch": "npm --prefix engine run watch --",
    "engine:test": "npm --prefix engine run test --",
    "cms:images": "node migration-scripts/check-cms-images.mjs"
  },
  "author": {
    "name": "Michael Wells",
    "email": "mike@sygnal.com",
    "url": "https://www.sygnal.com"
  },
  "license": "",
  "dependencies": {
    "jsdom": "^31.0.1",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
